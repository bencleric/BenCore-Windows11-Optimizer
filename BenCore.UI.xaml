<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BenCore | Windows Optimization Engine"
        Width="1240" Height="830" MinWidth="1060" MinHeight="730"
        WindowStartupLocation="CenterScreen" Background="#0B1020"
        FontFamily="Segoe UI" Foreground="#E8EEFF" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="CardBackground" Color="#151F34"/>
    <SolidColorBrush x:Key="BorderColor" Color="#27344C"/>
    <SolidColorBrush x:Key="AccentColor" Color="#62D6F6"/>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBackground}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="TextMuted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#91A3BE"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#F4F7FF"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="#AAB9D3"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="Padding" Value="17,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="9">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#202D46"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#62D6F6"/>
      <Setter Property="Foreground" Value="#061427"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="18,11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.86"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}" TargetType="Button">
      <Setter Property="Background" Value="#273951"/>
      <Setter Property="Foreground" Value="#E1EAF9"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E7EDFC"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#111A2D"/>
      <Setter Property="Foreground" Value="#EAF0FC"/>
      <Setter Property="RowBackground" Value="#111A2D"/>
      <Setter Property="AlternatingRowBackground" Value="#19263B"/>
      <Setter Property="BorderBrush" Value="#2B3952"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
      <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
      <Setter Property="RowHeight" Value="35"/>
      <Setter Property="ColumnHeaderHeight" Value="36"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#24334D"/>
      <Setter Property="Foreground" Value="#C7D7EF"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="#DFE8F8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,3"/>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Foreground" Value="#DFE8F8"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#215070"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#24344E"/></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#10182A" BorderBrush="#28354A" BorderThickness="0,0,1,0">
      <Grid Margin="20,27,20,20">
        <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical">
          <StackPanel Orientation="Horizontal">
            <Border Background="#163B53" CornerRadius="12" Width="48" Height="48" Margin="0,0,12,0">
              <TextBlock Text="B" FontWeight="Black" FontSize="30" Foreground="#62D6F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="24" FontWeight="Bold" Foreground="#F3F8FF" Text="BenCore"/>
              <TextBlock Text="PERFORMANCE STUDIO" FontSize="9" FontWeight="SemiBold" Foreground="#62D6F6"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="WORKSPACE" FontWeight="Bold" FontSize="10" Foreground="#66819F" Margin="12,0,0,8"/>
          <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Content="  ◈    Dashboard"/>
          <Button x:Name="NavOptimize" Style="{StaticResource NavButton}" Content="  ⚡    Optimize"/>
          <Button x:Name="NavStartup" Style="{StaticResource NavButton}" Content="  ▣    Startup apps"/>
          <Button x:Name="NavRecovery" Style="{StaticResource NavButton}" Content="  ↶    Recovery"/>
          <Button x:Name="NavAbout" Style="{StaticResource NavButton}" Content="  ⓘ    About BenCore"/>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Border Style="{StaticResource Card}" Padding="13" Background="#14243A">
            <StackPanel>
              <TextBlock Text="SAFE BY DESIGN" Foreground="#62D6F6" FontSize="10" FontWeight="Bold"/>
              <TextBlock Text="No Defender, Update, pagefile, or service tampering." Style="{StaticResource TextMuted}" FontSize="11" Margin="0,7,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock Text="BenCore v1.0 • Windows 11" Foreground="#7389A5" FontSize="10" Margin="6,16,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="30,22,30,14">
      <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Optimize the Core. Unleash the Performance." FontSize="20" Foreground="#F6F8FF" FontWeight="SemiBold"/>
          <TextBlock Text="Intelligent Windows optimization • Developed by Benie Mansueto Vison" Style="{StaticResource TextMuted}" Margin="0,7,0,0"/>
        </StackPanel>
        <Button x:Name="BtnRefresh" Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}" Content="↻  Refresh scan"/>
      </Grid>

      <Grid Grid.Row="1">
        <!-- DASHBOARD -->
        <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,10">
            <Border Style="{StaticResource Card}" Background="#152944" Padding="24" Margin="0,0,0,20">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="YOUR SYSTEM, IN FOCUS" Foreground="#6EDCF6" FontSize="10" FontWeight="Bold"/>
                  <TextBlock x:Name="TxtDevice" Text="Scanning this PC..." FontWeight="Bold" FontSize="23" Margin="0,10,0,0"/>
                  <TextBlock x:Name="TxtHardware" Style="{StaticResource TextMuted}" Margin="0,7,0,0"/>
                  <TextBlock Text="Performance improves most when you remove real bottlenecks, not critical Windows services." Foreground="#BFD0E6" FontSize="12" Margin="0,14,15,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0,0,0">
                  <TextBlock Text="SUGGESTED PROFILE" Foreground="#96BAD1" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                  <Border Background="#235571" CornerRadius="10" Padding="20,10" Margin="0,8,0,0">
                    <TextBlock x:Name="TxtSuggestedProfile" Text="Detecting..." FontWeight="Bold" Foreground="#C7F3FF" FontSize="17" HorizontalAlignment="Center"/>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
            <UniformGrid Columns="4" Margin="0,0,0,22">
              <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="INSTALLED MEMORY" Foreground="#9FB3D3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="TxtRAM" Text="--" FontSize="26" FontWeight="Bold" Margin="0,10,0,5"/><TextBlock Text="Physical RAM" Style="{StaticResource TextMuted}" FontSize="11"/></StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="MEMORY IN USE" Foreground="#9FB3D3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="TxtUsed" Text="--" FontSize="26" FontWeight="Bold" Margin="0,10,0,5"/><TextBlock Text="System-wide usage" Style="{StaticResource TextMuted}" FontSize="11"/></StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="AVAILABLE RAM" Foreground="#9FB3D3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="TxtFree" Text="--" FontSize="26" FontWeight="Bold" Margin="0,10,0,5"/><TextBlock Text="Available to apps" Style="{StaticResource TextMuted}" FontSize="11"/></StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="ACTIVE PROCESSES" Foreground="#9FB3D3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="TxtProcesses" Text="--" FontSize="26" FontWeight="Bold" Margin="0,10,0,5"/><TextBlock Text="Current snapshot" Style="{StaticResource TextMuted}" FontSize="11"/></StackPanel>
              </Border>
            </UniformGrid>
            <Grid Margin="0,0,0,20">
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="Top processes by memory" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <TextBlock Text="Working-set sizes may include shared memory." Style="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,12"/>
                  <DataGrid x:Name="GridProcesses" Height="258" CanUserResizeRows="False">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Application" Width="*" Binding="{Binding Name}"/>
                      <DataGridTextColumn Header="Memory" Width="115" Binding="{Binding RAM}"/>
                      <DataGridTextColumn Header="PID" Width="65" Binding="{Binding PID}"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                <StackPanel>
                  <TextBlock Text="Quick actions" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <TextBlock Text="Use safe, reversible changes tailored to this PC." Style="{StaticResource TextMuted}" Margin="0,0,0,17"/>
                  <Button x:Name="BtnGoOptimize" Style="{StaticResource PrimaryButton}" Content="Explore optimizations" Margin="0,0,0,12"/>
                  <Button x:Name="BtnGoStartup" Style="{StaticResource SecondaryButton}" Content="Manage startup apps" Margin="0,0,0,12"/>
                  <Button x:Name="BtnWindowsStorage" Style="{StaticResource SecondaryButton}" Content="Open Windows storage cleanup"/>
                  <TextBlock x:Name="TxtDiskInfo" Style="{StaticResource TextMuted}" FontSize="11" Margin="0,17,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- OPTIMIZE -->
        <ScrollViewer x:Name="PageOptimize" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,15">
            <TextBlock Style="{StaticResource SectionHeading}" Text="Tailored optimizations"/>
            <TextBlock Text="Choose a hardware-aware starting profile, then enable only the settings you want. Every proposed registry change can be previewed and restored." Style="{StaticResource TextMuted}" Margin="0,6,0,20"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,17">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Optimization profile" FontWeight="SemiBold" FontSize="16"/>
                  <TextBlock Text="Lite: 4–6 GB  •  Balanced: 8–23 GB  •  Workstation: 24 GB+" Style="{StaticResource TextMuted}" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <ComboBox x:Name="CboProfile" Grid.Column="1" Height="38" Background="#263D58" Foreground="#111D2F" FontWeight="SemiBold" VerticalAlignment="Center" SelectedIndex="1">
                  <ComboBoxItem Content="Lite"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Workstation"/>
                </ComboBox>
              </Grid>
            </Border>
            <StackPanel x:Name="PanelOptions"/>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Background="#142A3B">
              <StackPanel>
                <TextBlock Text="Low-RAM tip" FontWeight="Bold" Foreground="#75DFF2"/>
                <TextBlock Text="The most effective software change on many 4–8 GB PCs is reducing unwanted startup applications. Use the Startup apps tab too. BenCore never promises a particular FPS or RAM gain." Style="{StaticResource TextMuted}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,17,0,12">
              <Button x:Name="BtnPreview" Style="{StaticResource SecondaryButton}" Content="Preview changes" Margin="0,0,10,0"/>
              <Button x:Name="BtnApply" Style="{StaticResource PrimaryButton}" Content="Apply selected optimizations"/>
            </StackPanel>
            <TextBlock Text="A sign-out or restart may be required for visual changes. Preview never changes your computer." Style="{StaticResource TextMuted}" FontSize="11"/>
          </StackPanel>
        </ScrollViewer>

        <!-- STARTUP -->
        <Grid x:Name="PageStartup" Visibility="Collapsed" Margin="0,0,5,12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Style="{StaticResource SectionHeading}" Text="Startup app manager"/>
            <TextBlock Text="Safely disable or restore startup entries belonging to your Windows account. This view manages HKCU Run entries only; other startup apps can be managed in Windows Settings." Style="{StaticResource TextMuted}" Margin="0,7,0,0"/>
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="13" Margin="0,0,0,16">
            <DataGrid x:Name="GridStartup" SelectionMode="Single" CanUserResizeRows="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Application" Width="180" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Status" Width="90" Binding="{Binding Status}"/>
                <DataGridTextColumn Header="Command (display only)" Width="*" Binding="{Binding Command}"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0">
              <Button x:Name="BtnStartupSettings" Style="{StaticResource SecondaryButton}" Content="Windows startup settings" Margin="0,0,9,0"/>
              <Button x:Name="BtnStartupRefresh" Style="{StaticResource SecondaryButton}" Content="Refresh list"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Column="1">
              <Button x:Name="BtnStartupDisable" Style="{StaticResource SecondaryButton}" Content="Disable selected" Margin="0,0,10,0"/>
              <Button x:Name="BtnStartupEnable" Style="{StaticResource PrimaryButton}" Content="Restore selected"/>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- RECOVERY -->
        <Grid x:Name="PageRecovery" Visibility="Collapsed" Margin="0,0,5,12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,17">
            <TextBlock Style="{StaticResource SectionHeading}" Text="Backup and recovery"/>
            <TextBlock Text="Each optimization session backs up the exact previous registry values BEFORE modifying them. Select a session to restore, or restore the latest applied one. Changed values are not overwritten if another app has modified them since." Style="{StaticResource TextMuted}" Margin="0,7,0,0"/>
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="13" Margin="0,0,0,16">
            <DataGrid x:Name="GridSessions">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Width="175" Binding="{Binding Date}"/>
                <DataGridTextColumn Header="Status" Width="135" Binding="{Binding Status}"/>
                <DataGridTextColumn Header="Changes" Width="85" Binding="{Binding Changes}"/>
                <DataGridTextColumn Header="Session ID" Width="*" Binding="{Binding Id}"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0">
              <Button x:Name="BtnOpenLogs" Style="{StaticResource SecondaryButton}" Content="Open logs" Margin="0,0,9,0"/>
              <Button x:Name="BtnOpenBackups" Style="{StaticResource SecondaryButton}" Content="Open backup folder"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Column="1">
              <Button x:Name="BtnRecoveryRefresh" Style="{StaticResource SecondaryButton}" Content="Refresh" Margin="0,0,9,0"/>
              <Button x:Name="BtnRestoreSelected" Style="{StaticResource PrimaryButton}" Content="Restore selected session"/>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- ABOUT -->
        <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,8,0">
            <Border Style="{StaticResource Card}" Background="#15324B" Padding="28">
              <StackPanel>
                <TextBlock Text="BenCore" FontSize="40" FontWeight="Bold" Foreground="#71DDF9"/>
                <TextBlock Text="Optimize the Core. Unleash the Performance." FontSize="19" FontWeight="SemiBold" Margin="0,7,0,0"/>
                <TextBlock Text="Windows 11 Optimization Engine • Version 1.0" Style="{StaticResource TextMuted}" Margin="0,11,0,0"/>
                <TextBlock Text="Developed by Benie Mansueto Vison" Foreground="#D5E7FF" FontSize="14" FontWeight="SemiBold" Margin="0,15,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,17,0,0">
              <StackPanel>
                <TextBlock Text="Why BenCore is different" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="BenCore focuses on user-approved Windows changes instead of blanket service disabling, forced debloating, and unsupported network tweaks. It offers a real preview, reversible settings, startup-item control, live system metrics and an audit log." Style="{StaticResource TextMuted}" FontSize="14" Margin="0,12,0,0"/>
                <TextBlock Text="Compatibility" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,0"/>
                <TextBlock Text="Windows 11 desktop PCs and laptops with Windows PowerShell 5.1 and .NET/WPF. Works under the current Windows user without requesting administrator privileges. Features may vary by Windows build; no specific speed gain is guaranteed." Style="{StaticResource TextMuted}" FontSize="14" Margin="0,10,0,0"/>
                <TextBlock Text="Protected by design" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,0"/>
                <TextBlock Text="No changes to Windows Defender, Windows Update, critical services, virtual memory, security settings, drivers, or boot configuration. Startup app management is limited to the current user's Run registry entries." Style="{StaticResource TextMuted}" FontSize="14" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="TxtStatus" Text="Ready. All changes require your approval." Foreground="#8FA5C3" FontSize="11" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="BENCORE  •  LOCAL ONLY" Foreground="#6385A2" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
